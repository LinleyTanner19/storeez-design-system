  "semantic": {
    "$description": "Intent layer. data-theme \u00d7 data-mode override here and ONLY here. CSS build targets shown as $extensions.css.",
    "color": {
      "action": {
        "primary": {
          "$value": "{global.color.brand.storeez.dark}",
          "$type": "color",
          "$extensions": {
            "css": "--md-sys-color-primary",
            "modes": "per data-theme \u00d7 data-mode"
          }
        },
        "primary-text": {
          "$value": "{global.color.brand.storeez.dark}",
          "$type": "color",
          "$extensions": {
            "css": "--md-sys-color-primary-text",
            "note": "differs from fill only where fill fails 4.5:1 as text (kumite dark, violet dark)"
          }
        }
      },
      "risk": {
        "danger": {
          "$value": "{global.color.signal.error}",
          "$type": "color",
          "$extensions": {
            "css": "--error"
          }
        },
        "caution": {
          "$value": "{global.color.signal.warning}",
          "$type": "color",
          "$extensions": {
            "css": "--warning"
          }
        }
      },
      "feedback": {
        "positive": {
          "$value": "{global.color.signal.success}",
          "$type": "color",
          "$extensions": {
            "css": "--success"
          }
        },
        "informative": {
          "$value": "{global.color.signal.info}",
          "$type": "color",
          "$extensions": {
            "css": "--info"
          }
        }
      }
    },
