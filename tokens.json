{
  "$description": "Storeez DS — DTCG (W3C Design Tokens v2025.10) source of truth. Three tiers: global (raw, never overridden) → semantic (intent; themes/modes override ONLY here) → component (references semantic only). The shipped tokens/*.css is the build output of this graph; the 5-brand × 2-mode matrix maps to DTCG modes. Core coverage — extend per tier, never flatten.",
  "global": {
    "color": {
      "neutral": {
        "bg-dark": { "$value": "#0D0D0D", "$type": "color" },
        "bg-light": { "$value": "#FAFAF8", "$type": "color" },
        "text-dark": { "$value": "#F0EDE8", "$type": "color" },
        "text-light": { "$value": "#131313", "$type": "color" }
      },
      "brand": {
        "storeez": { "dark": { "$value": "#8DF2B0", "$type": "color" }, "light": { "$value": "#253F2F", "$type": "color" } },
        "kumite": { "dark": { "$value": "#CD2D26", "$type": "color" }, "dark-text": { "$value": "#F4685F", "$type": "color" }, "light": { "$value": "#A81F19", "$type": "color" } },
        "ilot": { "dark": { "$value": "#5AA9E6", "$type": "color" }, "light": { "$value": "#0057A3", "$type": "color" } },
        "travelz": { "dark": { "$value": "#2DD4BF", "$type": "color" }, "light": { "$value": "#0F766E", "$type": "color" } },
        "violet": { "dark": { "$value": "#7B2FBE", "$type": "color" }, "dark-text": { "$value": "#B388FF", "$type": "color" }, "light": { "$value": "#62228F", "$type": "color" } }
      },
      "signal": {
        "success": { "$value": "#22A65A", "$type": "color" },
        "warning": { "$value": "#E5A437", "$type": "color" },
        "error": { "$value": "#D93A3A", "$type": "color" },
        "info": { "$value": "#3B82F6", "$type": "color" }
      }
    },
    "space": {
      "2": { "$value": "2px", "$type": "dimension" }, "4": { "$value": "4px", "$type": "dimension" },
      "8": { "$value": "8px", "$type": "dimension" }, "12": { "$value": "12px", "$type": "dimension" },
      "16": { "$value": "16px", "$type": "dimension" }, "24": { "$value": "24px", "$type": "dimension" },
      "32": { "$value": "32px", "$type": "dimension" }, "48": { "$value": "48px", "$type": "dimension" },
      "64": { "$value": "64px", "$type": "dimension" }, "80": { "$value": "80px", "$type": "dimension" }
    },
    "radius": {
      "none": { "$value": "0px", "$type": "dimension" }, "xs": { "$value": "4px", "$type": "dimension" },
      "sm": { "$value": "8px", "$type": "dimension" }, "md": { "$value": "12px", "$type": "dimension" },
      "lg": { "$value": "16px", "$type": "dimension" }, "full": { "$value": "9999px", "$type": "dimension" }
    },
    "motion": {
      "instant": { "$value": "50ms", "$type": "duration" }, "fast": { "$value": "150ms", "$type": "duration" },
      "normal": { "$value": "250ms", "$type": "duration" }, "slow": { "$value": "400ms", "$type": "duration" },
      "deliberate": { "$value": "600ms", "$type": "duration" },
      "ease-standard": { "$value": [0.2, 0, 0, 1], "$type": "cubicBezier" },
      "ease-emphasised": { "$value": [0.05, 0.7, 0.1, 1], "$type": "cubicBezier" },
      "ease-accelerate": { "$value": [0.3, 0, 1, 1], "$type": "cubicBezier" },
      "ease-spring": { "$value": [0.34, 1.56, 0.64, 1], "$type": "cubicBezier" }
    },
    "type": {
      "family": {
        "display-storeez": { "$value": "Schibsted Grotesk", "$type": "fontFamily" },
        "display-kumite": { "$value": "Space Grotesk", "$type": "fontFamily" },
        "display-ilot": { "$value": "Playfair Display", "$type": "fontFamily" },
        "display-travelz": { "$value": "Manrope", "$type": "fontFamily" },
        "display-violet": { "$value": "Sora", "$type": "fontFamily" },
        "title": { "$value": "Archivo", "$type": "fontFamily" },
        "body": { "$value": "Inter", "$type": "fontFamily" },
        "mono": { "$value": "JetBrains Mono", "$type": "fontFamily" }
      }
    }
  },
  "semantic": {
    "$description": "Intent layer. data-theme × data-mode override here and ONLY here. CSS build targets shown as $extensions.css.",
    "color": {
      "action": {
        "primary": { "$value": "{global.color.brand.storeez.dark}", "$type": "color", "$extensions": { "css": "--md-sys-color-primary", "modes": "per data-theme × data-mode" } },
        "primary-text": { "$value": "{global.color.brand.storeez.dark}", "$type": "color", "$extensions": { "css": "--md-sys-color-primary-text", "note": "differs from fill only where fill fails 4.5:1 as text (kumite dark, violet dark)" } }
      },
      "risk": {
        "danger": { "$value": "{global.color.signal.error}", "$type": "color", "$extensions": { "css": "--error" } },
        "caution": { "$value": "{global.color.signal.warning}", "$type": "color", "$extensions": { "css": "--warning" } }
      },
      "feedback": {
        "positive": { "$value": "{global.color.signal.success}", "$type": "color", "$extensions": { "css": "--success" } },
        "informative": { "$value": "{global.color.signal.info}", "$type": "color", "$extensions": { "css": "--info" } }
      }
    },
    "state": {
      "hover": { "$value": 0.08, "$type": "number" }, "focus": { "$value": 0.1, "$type": "number" },
      "pressed": { "$value": 0.12, "$type": "number" }, "dragged": { "$value": 0.16, "$type": "number" },
      "disabled": { "$value": 0.38, "$type": "number" }
    }
  },
  "component": {
    "$description": "Scoped tier — references semantic only, never global.",
    "button": {
      "bg": { "$value": "{semantic.color.action.primary}", "$type": "color" },
      "bg-hover": { "$value": "{semantic.color.action.primary} + {semantic.state.hover} content overlay", "$type": "color" },
      "text-on-fill": { "$value": "on-primary per theme", "$type": "color", "$extensions": { "css": "--md-sys-color-on-primary" } },
      "radius": { "$value": "{global.radius.full}", "$type": "dimension" },
      "min-target": { "$value": "44px", "$type": "dimension", "$extensions": { "css": "--touch-target" } }
    }
  }
}
