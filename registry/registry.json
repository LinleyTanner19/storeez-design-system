        "loading",
        "empty",
        "happy",
        "error",
        "offline",
        "success",
        "ai-thinking",
        "ai-empty"
      ],
      "tokens": [
        "--md-sys-color-primary",
        "--md-sys-color-primary-text",
        "--radius-full",
        "--touch-target"
      ],
      "aiPrompt": "Primary action of any flow. Filled = the single primary CTA of a view; never stack two filled buttons. Loading swaps icon for spinner.",
